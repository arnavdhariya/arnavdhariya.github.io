---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/blog';
---
<Base title="Blog · Arnav Dhariya" description="Selected posts by Arnav Dhariya on database systems, privacy, and AI infrastructure.">
  <section class="hero" aria-labelledby="h-blog">
    <h1 id="h-blog">Blog</h1>
    <p class="lede">Selected posts.</p>
    {posts.length ? (
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <h2><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h2>
            {(post.source || post.date) && <p class="blog-meta">{[post.source, post.date].filter(Boolean).join(" · ")}</p>}
            {post.blurb && <p>{post.blurb}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p style="margin-top:1.5rem">Posts are coming soon.</p>
    )}
  </section>
</Base>
