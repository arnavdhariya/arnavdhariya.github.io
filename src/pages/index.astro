---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile_pic.webp';
import { site, publications } from '../data/site';
import { news } from '../data/news';

const positions = (await getCollection('positions')).sort((a, b) => a.data.order - b.data.order);
const links = [
  ['Google Scholar', site.links.scholar, true],
  ['GitHub', site.links.github, true],
  ['LinkedIn', site.links.linkedin, true],
  ['X', site.links.x, true],
].filter(([, href]) => href) as [string, string, boolean][];
const period = (d: { start?: string; end: string }) => (d.start ? `${d.start} – ${d.end}` : d.end);
---
<Base>
  <section class="hero" id="top" aria-labelledby="h-name">
    <p class="status-line"><em>Actively looking for PhD positions in databases starting fall 2027 and a summer 2027 internship.</em></p>
    <h1 id="h-name">Arnav Dhariya</h1>
    <div class="about-grid">
      <Image src={profile} alt="Portrait of Arnav Dhariya" class="portrait" width={280} height={360} loading="eager" />
      <div>
        <p class="lede">
          I'm an undergraduate researcher at the <strong>University of California, Irvine</strong>,
          graduating June 2027 with a B.S. in Computer Science.
          My work spans data privacy and deletion, distributed systems for vector search and ML workloads,
          and agentic AI infrastructure. I work with
          <strong>Prof. Shreya Shankar</strong>, <strong>Prof. Sharad Mehrotra</strong>,
          <strong>Prof. Sangeetha Abdu Jyothi</strong>, and <strong>Prof. Habiba Farrukh</strong>,
          and previously with <strong>Prof. Wayne Hayes</strong>.
        </p>
        <ul class="hero-links" aria-label="Profiles">
          <li>{site.emailDisplay}</li>
      {links.map(([label, href, ext]) => <li><a href={href} {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>{label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="news" aria-labelledby="h-news">
    <h2 id="h-news">Recent news</h2>
    <ul class="news-list">
      {news.map((n) => (
        <li>
          <span class="news-date">{n.date}</span>
          <span>{n.href ? <a href={n.href} target="_blank" rel="noopener">{n.text}</a> : n.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="publications" aria-labelledby="h-pubs">
    <h2 id="h-pubs">Papers</h2>
    <div class="pub-list">
      {publications.map((pub) => (
        <article class="pub">
          <div class="pub-top">
            <h3>{pub.title}</h3>
            <p class="pub-venue">{pub.venue}</p>
          </div>
          <p class="pub-authors">{pub.authors.map((a, i) => (<>{i > 0 && ', '}{a.startsWith('Dhariya') ? <strong>{a}</strong> : a}</>))}</p>
          <p class="pub-abstract">{pub.abstract}</p>
          <ul class="pub-links" style="list-style:none">
            {pub.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="research" aria-labelledby="h-research">
    <h2 id="h-research">Research experience</h2>
    <div class="exp-list">
      {positions.map((p) => (
        <article class="exp">
          <div class="exp-row">
            {p.data.logo && <img class="exp-logo" src={p.data.logo} alt="" width="44" height="44" />}
            <div class="exp-body">
              <div class="exp-top">
                <h3>{p.data.lab}</h3>
                <p class="exp-period">{period(p.data)}</p>
              </div>
              <p class="exp-meta">{p.data.role}</p>
              <p class="blurb">{p.data.blurb}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

</Base>
